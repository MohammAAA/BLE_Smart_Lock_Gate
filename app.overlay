/* Zephyr needs to know which virtual device to map the console to */

/* app.overlay — define external LED on P0.20
 *
 * We create a custom LED node (not led0, to avoid any conflict with
 * the board's on-board LED definitions). The main.c references this
 * via DT_NODELABEL(ext_led).
 */

/ {
    ext_leds {
        compatible = "gpio-leds";
        ext_led: ext_led_0 {
            gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>;
            label = "External LED P0.20";
        };
    };
};