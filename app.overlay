/* app.overlay — 5 diagnostic LEDs + USB CDC ACM console
 * Zephyr needs to know which virtual device to map the console to

 *
 * LEDs (all active-high, external through 330Ω resistor to GND):
 *   LED 1 (P0.20) - App started
 *   LED 2 (P0.22) - Survived SYS_INIT
 *   LED 3 (P0.09) - USB init complete
 *   LED 4 (P1.00) - DTR wait complete
 *   LED 5 (P0.11) - Main loop (blinks)
 *
 * Note: P0.24/P0.25 are USB D+/D- — never use for GPIO.
 */

/ {
    diag_leds {
        compatible = "gpio-leds";
        diag_led_1: diag_led_1 { gpios = <&gpio0 20 GPIO_ACTIVE_HIGH>; label = "Diag LED 1"; };
        diag_led_2: diag_led_2 { gpios = <&gpio0 22 GPIO_ACTIVE_HIGH>; label = "Diag LED 2"; };
        diag_led_3: diag_led_3 { gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>; label = "Diag LED 3"; };
        diag_led_4: diag_led_4 { gpios = <&gpio1 0 GPIO_ACTIVE_HIGH>; label = "Diag LED 4"; };
        diag_led_5: diag_led_5 { gpios = <&gpio0 11 GPIO_ACTIVE_HIGH>; label = "Diag LED 5"; };
    };

    relays {
        compatible = "gpio-leds";
        gate_relay: gate_relay {
            gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
            label = "Gate Relay Driver";
        };
    };

    reeds {
        compatible = "gpio-leds";
        gate_reed: gate_reed {
            gpios = <&gpio0 31 GPIO_PULL_UP>;
            label = "Gate reed switch";
        };
    };

    chosen {
        zephyr,console = &board_cdc_acm_uart;
        zephyr,shell-uart = &board_cdc_acm_uart;
    };
};

&usbd {
    status = "okay";
};

